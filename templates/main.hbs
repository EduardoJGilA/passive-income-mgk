<div class="pim pim-dir-root">
  <header class="pim-dir-header">
    <div class="pim-dir-brand">
      <div class="pim-dir-brand-icon"><i class="fa-solid fa-landmark"></i></div>
      <div class="pim-dir-brand-txt">
        <h2>{{localize "PIM.Title"}}</h2>
        <span class="pim-dir-subtitle">{{holdings.length}} {{localize "PIM.HoldingsCount"}}</span>
      </div>
    </div>

    <div class="pim-dir-search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="search" placeholder="{{localize "PIM.SearchHoldings"}}" data-action="filterHoldings">
    </div>

    {{#if isGM}}
    <div class="pim-dir-actions">
      <button type="button" class="pim-btn-create" data-action="create"><i class="fa-solid fa-plus"></i> {{localize "PIM.New"}}</button>
      <button type="button" class="pim-btn-subtle" data-action="import" title="{{localize "PIM.Import"}}"><i class="fa-solid fa-file-import"></i> {{localize "PIM.Import"}}</button>
      <button type="button" class="pim-btn-subtle" data-action="tick" title="{{localize "PIM.Tick"}}"><i class="fa-solid fa-forward-step"></i> {{localize "PIM.Tick"}}</button>
    </div>
    {{/if}}
  </header>

  <div class="pim-dir-body">
    {{#if holdings.length}}
    <div class="pim-dir-grid">
      {{#each holdings as |h|}}
      <article class="pim-dir-card" data-id="{{h.id}}">
        <div class="pim-dir-card-media" data-action="openHolding" data-id="{{h.id}}">
          <img src="{{h.img}}" alt="{{h.name}}">
          <div class="pim-dir-card-overlay"></div>
          {{#if h.kind}}<span class="pim-kind">{{h.kind}}</span>{{/if}}
          <span class="pim-dir-card-badges">
            {{#if h.pending}}<span class="pim-badge pim-badge-bell" title="{{localize "PIM.BEvents"}}"><i class="fa-solid fa-bell"></i></span>{{/if}}
            {{#if h.ready}}<span class="pim-badge pim-badge-build" title="{{localize "PIM.BBuild"}}"><i class="fa-solid fa-hammer"></i> {{h.ready}}</span>{{/if}}
            {{#if h.due}}<span class="pim-badge pim-badge-due" title="{{localize "PIM.BCollect"}}"><i class="fa-solid fa-sack-dollar"></i> {{h.due}} {{../cur}}</span>{{/if}}
          </span>
        </div>

        <div class="pim-dir-card-content">
          <div class="pim-dir-card-head" data-action="openHolding" data-id="{{h.id}}">
            <h3 class="pim-dir-card-title">{{h.name}}</h3>
            {{#if h.desc}}<p class="pim-dir-card-desc">{{h.desc}}</p>{{/if}}
          </div>

          <div class="pim-dir-card-kpis">
            <div class="pim-dir-kpi" title="{{localize "PIM.Fund"}}">
              <span class="pim-dir-kpi-lbl"><i class="fa-solid fa-vault"></i> {{localize "PIM.Fund"}}</span>
              <b>{{h.fund}}</b> <small>{{../cur}}</small>
            </div>
            <div class="pim-dir-kpi" title="{{localize "PIM.IncomeShort"}}">
              <span class="pim-dir-kpi-lbl"><i class="fa-solid fa-chart-line"></i> {{localize "PIM.IncomeShort"}}</span>
              <b>{{h.incomeTxt}}</b> <small>{{../cur}}</small>
            </div>
            <div class="pim-dir-kpi" title="{{localize "PIM.Sec.owners"}}">
              <span class="pim-dir-kpi-lbl"><i class="fa-solid fa-users"></i> {{localize "PIM.Sec.owners"}}</span>
              <b>{{h.owners.length}}</b>
            </div>
          </div>

          <div class="pim-dir-card-foot">
            <button type="button" class="pim-btn-open" data-action="openHolding" data-id="{{h.id}}">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "PIM.ViewHolding"}}
            </button>

            {{#if ../isGM}}
            <div class="pim-dir-card-gm">
              <button type="button" class="pim-btn-icon" data-action="edit" data-id="{{h.id}}" data-tooltip="PIM.Edit"><i class="fa-solid fa-pen-to-square"></i></button>
              <button type="button" class="pim-btn-icon pim-btn-danger" data-action="remove" data-id="{{h.id}}" data-tooltip="PIM.Delete"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{/if}}
          </div>
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <div class="pim-blank">
      <div class="pim-blank-card">
        <div class="pim-blank-icon"><i class="fa-solid fa-landmark"></i></div>
        <h2>{{localize "PIM.Title"}}</h2>
        <p>{{localize "PIM.None"}}</p>
        {{#if isGM}}
        <div class="pim-blank-actions">
          <button type="button" class="pim-btn-primary" data-action="create"><i class="fa-solid fa-plus"></i> {{localize "PIM.New"}}</button>
          <button type="button" class="pim-btn-subtle" data-action="import"><i class="fa-solid fa-file-import"></i> {{localize "PIM.Import"}}</button>
        </div>
        {{/if}}
      </div>
    </div>
    {{/if}}
  </div>
</div>
