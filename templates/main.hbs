<div class="pim">
  <aside class="pim-side">
    <div class="pim-side-list">
      {{#each holdings as |x|}}
      <button type="button" class="pim-item {{#if (eq x.id ../h.id)}}active{{/if}}" data-action="select" data-id="{{x.id}}">
        <img src="{{x.img}}" alt="">
        <span class="pim-item-txt"><b>{{x.name}}</b><small>{{x.kind}}</small></span>
        <span class="pim-badges">
          {{#if x.pending}}<i class="fa-solid fa-bell" title="{{localize "PIM.BEvents"}}"></i>{{/if}}
          {{#if x.ready}}<i class="fa-solid fa-hammer" title="{{localize "PIM.BBuild"}}"></i>{{/if}}
          {{#if x.due}}<i class="fa-solid fa-sack-dollar" title="{{localize "PIM.BCollect"}}"></i>{{/if}}
        </span>
      </button>
      {{else}}<p class="pim-empty">{{localize "PIM.None"}}</p>{{/each}}
    </div>
    {{#if isGM}}<div class="pim-side-foot">
      <button type="button" data-action="create"><i class="fa-solid fa-plus"></i> {{localize "PIM.New"}}</button>
      <button type="button" data-action="import"><i class="fa-solid fa-file-import"></i> {{localize "PIM.Import"}}</button>
      <button type="button" data-action="tick"><i class="fa-solid fa-forward"></i> {{localize "PIM.Tick"}}</button>
    </div>{{/if}}
  </aside>

  {{#if h}}
  <main class="pim-main" data-id="{{h.id}}">
    <header class="pim-hero">
      <img src="{{h.img}}" alt="">
      <div class="pim-hero-txt">
        <h2>{{h.name}}</h2>
        {{#if h.kind}}<span class="pim-kind">{{h.kind}}</span>{{/if}}
        {{#if h.desc}}<p>{{h.desc}}</p>{{/if}}
      </div>
      {{#if isGM}}<div class="pim-gm">
        <button type="button" data-action="fire" data-tooltip="PIM.Fire"><i class="fa-solid fa-bolt"></i></button>
        <button type="button" data-action="edit" data-tooltip="PIM.Edit"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="export" data-tooltip="PIM.Export"><i class="fa-solid fa-file-export"></i></button>
        <button type="button" data-action="sell" data-tooltip="PIM.Sell"><i class="fa-solid fa-hand-holding-dollar"></i></button>
        <button type="button" data-action="remove" data-tooltip="PIM.Delete"><i class="fa-solid fa-trash"></i></button>
      </div>{{/if}}
    </header>

    <nav class="sheet-tabs tabs pim-tabs">
      {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="goTab" data-tab="{{id}}"><i class="fa-solid {{icon}}" inert></i> <span>{{label}}</span></a>{{/each}}
    </nav>

    <div class="pim-pane">
      {{#if (eq tab "overview")}}
        {{#if h.pending}}
        <section class="pim-event {{h.pending.kind}}">
          <div>
            <h3><i class="fa-solid fa-bell"></i> {{h.pending.title}}</h3>
            <p>{{h.pending.text}}</p>
            <small>{{h.pending.left}} {{localize "PIM.PeriodsLeft"}}</small>
          </div>
          <button type="button" data-action="attend"><i class="fa-solid fa-hand"></i> {{localize "PIM.Attend"}}</button>
        </section>
        {{/if}}
        <div class="pim-kpis">
          <div class="pim-kpi"><label>{{localize "PIM.Fund"}}</label><b>{{h.fund}}</b><small>{{cur}}</small></div>
          <div class="pim-kpi"><label>{{localize "PIM.IncomeShort"}}</label><b>{{h.incomeTxt}}</b><small>{{#if h.passive}}{{#if (gt h.passive -1)}}+{{/if}}{{h.passive}} {{/if}}{{#if h.upkeep}}− {{h.upkeep}}{{/if}} {{cur}}</small></div>
          <div class="pim-kpi"><label>{{localize "PIM.EventChance"}}</label><b>{{h.eventChance}}%</b></div>
        </div>
        {{#if h.stats.length}}
        <h4 class="pim-h">{{localize "PIM.Sec.stats"}}</h4>
        <div class="pim-stats">
          {{#each h.stats}}<div class="pim-stat">
            <div class="pim-stat-top"><span>{{name}}</span><b>{{value}}{{#if max}} / {{max}}{{/if}}</b></div>
            {{#if pct}}<div class="pim-bar-track"><div class="pim-bar-fill" style="width:{{pct}}%"></div></div>{{/if}}
          </div>{{/each}}
        </div>
        {{/if}}
      {{/if}}

      {{#if (eq tab "owners")}}
        <div class="pim-cards">
          {{#each h.owners as |o|}}<div class="pim-card" data-aid="{{o.id}}">
            <img src="{{o.img}}" alt="">
            <div class="pim-card-txt"><b>{{o.name}}</b><small>{{o.share}}%</small></div>
            <div class="pim-card-num"><b>{{o.bal}}</b><small>{{../cur}}</small></div>
            <div class="pim-card-act">
              {{#if o.canCollect}}<button type="button" data-action="collect" data-aid="{{o.id}}"><i class="fa-solid fa-sack-dollar"></i> {{localize "PIM.Collect"}}</button>{{/if}}
              {{#if o.canMove}}<button type="button" data-action="transfer" data-tooltip="PIM.Transfer"><i class="fa-solid fa-right-left"></i></button>{{/if}}
            </div>
          </div>{{else}}<p class="pim-empty">{{localize "PIM.NoOwners"}}</p>{{/each}}
        </div>
      {{/if}}

      {{#if (eq tab "units")}}
        <div class="pim-cards">
          {{#each h.units as |u|}}<div class="pim-card" data-i="{{@index}}">
            <div class="pim-card-txt"><b>{{u.name}}</b><small>−{{u.upkeep}} / +{{u.income}} {{../cur}}</small></div>
            <div class="pim-card-num"><b>{{u.count}}</b>{{#if u.max}}<small>/ {{u.max}}</small>{{/if}}</div>
            <div class="pim-card-act">
              <button type="button" data-action="dismiss" {{#unless u.count}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
              <button type="button" data-action="hire" {{#unless u.canHire}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{u.hire}} {{../cur}}</button>
            </div>
          </div>{{else}}<p class="pim-empty">{{localize "PIM.NoUnits"}}</p>{{/each}}
        </div>
      {{/if}}

      {{#if (eq tab "builds")}}
        <div class="pim-cards">
          {{#each h.upgrades as |u|}}<div class="pim-card {{#if u.done}}done{{/if}}" data-uid="{{u.id}}">
            <div class="pim-card-txt">
              <b>{{u.name}}</b>
              <small>{{#if u.bonus}}+{{u.bonus}}/{{localize "PIM.Per"}} · {{/if}}{{u.cost}} {{../cur}}{{#if u.time}} · {{u.time}} {{localize "PIM.PeriodsLeft"}}{{/if}}</small>
              {{#if u.desc}}<small>{{u.desc}}</small>{{/if}}
              {{#if u.left}}<div class="pim-bar-track"><div class="pim-bar-fill" style="width:{{u.pct}}%"></div></div>{{/if}}
            </div>
            <div class="pim-card-act">
              {{#if u.done}}<em><i class="fa-solid fa-check"></i> {{localize "PIM.Done"}}</em>
              {{else if u.left}}<em><i class="fa-solid fa-hammer"></i> {{u.left}}</em>
              {{else}}
                {{#if u.offered}}<button type="button" data-action="buy" {{#unless u.afford}}disabled data-tooltip="PIM.NoFunds"{{/unless}}><i class="fa-solid fa-cart-shopping"></i> {{localize "PIM.Buy"}}</button>{{/if}}
                {{#if ../isGM}}<button type="button" data-action="offer">{{#if u.offered}}{{localize "PIM.Withdraw"}}{{else}}{{localize "PIM.Offer"}}{{/if}}</button>{{/if}}
              {{/if}}
            </div>
          </div>{{else}}<p class="pim-empty">{{localize "PIM.NoBuilds"}}</p>{{/each}}
        </div>
      {{/if}}

      {{#if (eq tab "log")}}
        <ul class="pim-log">{{#each h.log}}<li><time>{{at}}</time><span>{{text}}</span></li>{{else}}<p class="pim-empty">{{localize "PIM.NoLog"}}</p>{{/each}}</ul>
      {{/if}}
    </div>
  </main>
  {{else}}
  <main class="pim-main pim-blank"><i class="fa-solid fa-coins"></i><p>{{localize "PIM.None"}}</p></main>
  {{/if}}
</div>
