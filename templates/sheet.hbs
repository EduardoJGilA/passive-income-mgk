<div class="pim pim-sheet" data-id="{{h.id}}">
  <header class="pim-hero" style="--bg:url('{{h.img}}')">
    <div class="pim-hero-media">
      <img src="{{h.img}}" alt="{{h.name}}">
    </div>
    <div class="pim-hero-txt">
      <div class="pim-hero-title-row">
        <h2>{{h.name}}</h2>
        {{#if h.kind}}<span class="pim-kind">{{h.kind}}</span>{{/if}}
        {{#if currentSeason}}<span class="pim-pill pim-pill-season" title="{{localize "PIM.Season"}}"><i class="fa-solid fa-cloud-sun"></i> {{currentSeason}} (x{{currentSeasonMult}})</span>{{/if}}
      </div>
      {{#if h.desc}}<p class="pim-desc">{{h.desc}}</p>{{/if}}
    </div>
    {{#if isGM}}<div class="pim-gm">
      <button type="button" class="pim-btn-icon" data-action="fire" data-id="{{h.id}}" data-tooltip="PIM.Fire"><i class="fa-solid fa-bolt"></i></button>
      <button type="button" class="pim-btn-icon" data-action="edit" data-id="{{h.id}}" data-tooltip="PIM.Edit"><i class="fa-solid fa-pen-to-square"></i></button>
      <button type="button" class="pim-btn-icon" data-action="export" data-id="{{h.id}}" data-tooltip="PIM.Export"><i class="fa-solid fa-file-export"></i></button>
      <button type="button" class="pim-btn-icon" data-action="saveTemplate" data-id="{{h.id}}" data-tooltip="PIM.SaveTemplate"><i class="fa-solid fa-bookmark"></i></button>
      <button type="button" class="pim-btn-icon" data-action="sell" data-id="{{h.id}}" data-tooltip="PIM.Sell"><i class="fa-solid fa-hand-holding-dollar"></i></button>
      <button type="button" class="pim-btn-icon pim-btn-danger" data-action="remove" data-id="{{h.id}}" data-tooltip="PIM.Delete"><i class="fa-solid fa-trash"></i></button>
    </div>{{/if}}
  </header>

  <nav class="sheet-tabs tabs pim-tabs">
    {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="goTab" data-tab="{{id}}"><i class="fa-solid {{icon}}" inert></i> <span>{{label}}</span></a>{{/each}}
  </nav>

  <div class="pim-pane">
    {{#if (eq tab "overview")}}
      {{#if h.pending}}
      <section class="pim-event {{h.pending.kind}}">
        <div class="pim-event-badge">
          <i class="fa-solid {{#if (eq h.pending.kind "good")}}fa-circle-check{{else if (eq h.pending.kind "bad")}}fa-triangle-exclamation{{else}}fa-bell{{/if}}"></i>
        </div>
        <div class="pim-event-content">
          <div class="pim-event-top">
            <h3>{{h.pending.title}}</h3>
            <span class="pim-event-time"><i class="fa-solid fa-hourglass-half"></i> {{h.pending.left}} {{localize "PIM.PeriodsLeft"}}</span>
          </div>
          <p>{{h.pending.text}}</p>
        </div>
        <button type="button" class="pim-btn-attend" data-action="attend" data-id="{{h.id}}"><i class="fa-solid fa-hand"></i> {{localize "PIM.Attend"}}</button>
      </section>
      {{/if}}

      <div class="pim-kpis">
        <div class="pim-kpi pim-kpi-fund">
          <div class="pim-kpi-header">
            <span class="pim-kpi-icon"><i class="fa-solid fa-vault"></i></span>
            <label>{{localize "PIM.Fund"}}</label>
          </div>
          <div class="pim-kpi-value">
            <b>{{h.fund}}</b>
            <small>{{cur}}</small>
          </div>
        </div>
        <div class="pim-kpi pim-kpi-income">
          <div class="pim-kpi-header">
            <span class="pim-kpi-icon"><i class="fa-solid fa-chart-line"></i></span>
            <label>{{localize "PIM.IncomeShort"}}</label>
          </div>
          <div class="pim-kpi-value">
            <b>{{h.incomeTxt}}</b>
            <small class="pim-kpi-sub">{{#if h.passive}}{{#if (gt h.passive -1)}}+{{/if}}{{h.passive}} {{/if}}{{#if h.upkeep}}− {{h.upkeep}}{{/if}} {{cur}}</small>
          </div>
        </div>
        <div class="pim-kpi pim-kpi-event">
          <div class="pim-kpi-header">
            <span class="pim-kpi-icon"><i class="fa-solid fa-dice-d20"></i></span>
            <label>{{localize "PIM.EventChance"}}</label>
          </div>
          <div class="pim-kpi-value">
            <b>{{h.eventChance}}%</b>
            <small class="pim-kpi-sub">{{localize "PIM.Per"}}</small>
          </div>
        </div>
      </div>

      {{#if h.stats.length}}
      <div class="pim-sec-block">
        <h4 class="pim-h"><i class="fa-solid fa-sliders"></i> {{localize "PIM.Sec.stats"}}</h4>
        <div class="pim-stats">
          {{#each h.stats}}<div class="pim-stat">
            <div class="pim-stat-top"><span>{{name}}</span><b>{{value}}{{#if max}} / {{max}}{{/if}}</b>{{#if extra}}<small class="pim-staff-extra" data-tooltip="PIM.FromStaff">(+{{extra}})</small>{{/if}}</div>
            {{#if pct}}<div class="pim-bar-track"><div class="pim-bar-fill" style="width:{{pct}}%"></div></div>{{/if}}
          </div>{{/each}}
        </div>
      </div>
      {{/if}}
    {{/if}}

    {{#if (eq tab "owners")}}
      {{#if isGM}}
      <div class="pim-tab-actions">
        <button type="button" class="pim-btn-subtle" data-action="collectAll" data-id="{{h.id}}"><i class="fa-solid fa-money-bill-wave"></i> {{localize "PIM.CollectAll"}}</button>
      </div>
      {{/if}}
      <div class="pim-cards">
        {{#each h.owners as |o|}}<div class="pim-card pim-owner-card" data-aid="{{o.id}}">
          <img class="pim-card-avatar" src="{{o.img}}" alt="{{o.name}}">
          <div class="pim-card-txt">
            <b>{{o.name}}</b>
            <span class="pim-pill pim-pill-share"><i class="fa-solid fa-percent"></i> {{o.share}}% {{localize "PIM.F.pct"}}</span>
          </div>
          <div class="pim-card-num {{#if o.isDebt}}pim-debt{{/if}}">
            <b>{{o.bal}}</b><small>{{../cur}}</small>
            {{#if o.isDebt}}<span class="pim-pill pim-pill-debt">{{localize "PIM.Debt"}}</span>{{/if}}
          </div>
          <div class="pim-card-act">
            {{#if o.canCollect}}<button type="button" class="pim-btn-collect" data-action="collect" data-aid="{{o.id}}" data-id="{{../h.id}}"><i class="fa-solid fa-sack-dollar"></i> {{localize "PIM.Collect"}}</button>{{/if}}
            {{#if o.canMove}}<button type="button" class="pim-btn-icon" data-action="transfer" data-aid="{{o.id}}" data-id="{{../h.id}}" data-tooltip="PIM.Transfer"><i class="fa-solid fa-right-left"></i></button>{{/if}}
          </div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoOwners"}}</p>{{/each}}
      </div>
    {{/if}}

    {{#if (eq tab "units")}}
      <div class="pim-cards">
        {{#each h.units as |u|}}<div class="pim-card pim-unit-card" data-i="{{@index}}">
          {{#if u.img}}<img class="pim-card-thumb" src="{{u.img}}" alt="">{{/if}}
          <div class="pim-card-txt">
            <b>{{u.name}}</b>
            <small class="pim-unit-eco"><i class="fa-solid fa-coins"></i> −{{u.upkeep}} / +{{u.income}} {{../cur}}{{#if u.prod}} · <i class="fa-solid fa-boxes-stacked"></i> {{u.prod}}{{#if u.makes}} {{u.makes}}{{/if}}{{/if}}</small>
            {{#if u.desc}}<small class="pim-build-desc">{{u.desc}}</small>{{/if}}
            {{#if u.idle}}<small class="pim-unit-idle"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PIM.Working" n=u.working}}</small>{{/if}}
          </div>
          <div class="pim-card-num"><b>{{u.count}}</b>{{#if u.max}}<small class="pim-card-max">/ {{u.max}}</small>{{/if}}</div>
          <div class="pim-card-act">
            <button type="button" class="pim-btn-icon" data-action="dismiss" data-i="{{@index}}" data-id="{{../h.id}}" {{#unless u.count}}disabled{{/unless}} title="Dismiss"><i class="fa-solid fa-minus"></i></button>
            <button type="button" class="pim-btn-hire" data-action="hire" data-i="{{@index}}" data-id="{{../h.id}}" {{#unless u.canHire}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{u.hire}} {{../cur}}</button>
          </div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoUnits"}}</p>{{/each}}
      </div>
    {{/if}}

    {{#if (eq tab "staff")}}
      <div class="pim-tab-actions"><span class="pim-kpi-sub"><i class="fa-solid fa-arrow-trend-down"></i> {{localize "PIM.Wages"}}: <b>{{h.wages}}</b> {{cur}} / {{localize "PIM.Per"}}</span></div>
      <div class="pim-cards">
        {{#each h.staff as |s|}}<div class="pim-card pim-staff-card {{#unless s.hired}}pim-candidate{{/unless}}" data-sid="{{s.id}}">
          {{#if s.img}}<img class="pim-card-thumb" src="{{s.img}}" alt="">{{/if}}
          <div class="pim-card-txt">
            <div class="pim-build-title"><b>{{s.name}}</b> <span class="pim-pill">{{s.role}}</span> <span class="pim-stars" data-tooltip="{{s.stars}}/5">{{s.starTxt}}</span>
              {{#if s.hired}}<span class="pim-badge-done"><i class="fa-solid fa-check"></i> {{localize "PIM.Hired"}}</span>{{else}}<span class="pim-pill">{{localize "PIM.Candidate"}}</span>{{/if}}</div>
            {{#if s.desc}}<small class="pim-build-desc">{{s.desc}}</small>{{/if}}
            <small class="pim-build-meta"><i class="fa-solid fa-wand-magic-sparkles"></i> {{s.fxTxt}} · <i class="fa-solid fa-coins"></i> {{s.wage}} {{../cur}}/{{localize "PIM.Per"}}{{#unless s.hired}}{{#if s.fee}} · {{localize "PIM.Fee"}} {{s.fee}} {{../cur}}{{/if}}{{/unless}}</small>
            {{#if s.left}}<div class="pim-progress-wrap"><div class="pim-bar-track"><div class="pim-bar-fill" style="width:{{s.pct}}%"></div></div>
              <span class="pim-progress-txt"><i class="fa-solid fa-graduation-cap"></i> {{s.left}} {{localize "PIM.PeriodsLeft"}}</span></div>{{/if}}
          </div>
          <div class="pim-card-act">
            {{#if s.hired}}
              {{#if s.canTrain}}<button type="button" class="pim-btn-buy" data-action="staffAct" data-op="trainStaff" data-tooltip="PIM.TrainHint"><i class="fa-solid fa-graduation-cap"></i> {{s.trainCost}} {{../cur}}</button>{{/if}}
              <button type="button" class="pim-btn-icon pim-btn-danger" data-action="staffAct" data-op="fireStaff" data-tooltip="PIM.Fire_"><i class="fa-solid fa-user-minus"></i></button>
            {{else}}
              {{#if s.offered}}<button type="button" class="pim-btn-hire" data-action="staffAct" data-op="hireStaff" {{#unless s.canHire}}disabled data-tooltip="PIM.NoFunds"{{/unless}}><i class="fa-solid fa-user-plus"></i> {{localize "PIM.HireStaff"}}</button>{{/if}}
              {{#if ../isGM}}<button type="button" class="pim-btn-subtle" data-action="staffAct" data-op="offerStaff">{{#if s.offered}}<i class="fa-solid fa-eye-slash"></i> {{localize "PIM.Withdraw"}}{{else}}<i class="fa-solid fa-bullhorn"></i> {{localize "PIM.Offer"}}{{/if}}</button>{{/if}}
            {{/if}}
          </div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoStaff"}}</p>{{/each}}
      </div>
    {{/if}}

    {{#if (eq tab "trade")}}
      <div class="pim-tab-actions">
        <span class="pim-kpi-sub"><i class="fa-solid fa-scale-balanced"></i> {{localize "PIM.Sales"}}: <b>{{h.trade.total}}</b> {{cur}} / {{localize "PIM.Month"}}</span>
        <button type="button" class="pim-btn-subtle" data-action="addProduct"><i class="fa-solid fa-plus"></i> {{localize "PIM.AddProduct"}}</button>
      </div>
      <div class="pim-cards">
        {{#each h.trade.products as |p|}}<div class="pim-card pim-product-card {{#if p.locked}}pim-locked{{/if}}" data-p="{{@index}}">
          {{#if p.img}}<img class="pim-card-thumb" src="{{p.img}}" alt="">{{/if}}
          <div class="pim-card-txt">
            <b>{{p.name}}</b>
            <small>{{localize "PIM.Made"}} {{p.made}} {{p.unit}} · {{localize "PIM.Stock"}} {{p.stock}} · {{localize "PIM.Fair"}} {{p.fair}} {{../cur}}</small>
            <small>{{localize "PIM.MarketBuys" n=p.want unit=p.unit}} → {{p.sold}} = +{{p.revenue}} {{../cur}}</small>
            {{#if p.desc}}<small class="pim-build-desc">{{p.desc}}</small>{{/if}}
            {{#if p.locked}}<small class="pim-unit-idle"><i class="fa-solid fa-lock"></i> {{localize "PIM.Requires"}}: {{p.cond}}</small>{{/if}}
            {{#if p.spoiled}}<small class="pim-unit-idle"><i class="fa-solid fa-hourglass-end"></i> {{localize "PIM.Spoils" n=p.spoiled}}</small>{{/if}}
            {{#unless p.base}}<small class="pim-unit-idle"><i class="fa-solid fa-hourglass"></i> {{localize "PIM.NoBase"}}</small>{{/unless}}
          </div>
          <div class="pim-card-act">
            <label class="pim-price"><i class="fa-solid fa-tag"></i><input type="number" step="any" min="0" value="{{p.price}}"></label>
            <button type="button" class="pim-btn-subtle" data-action="setPrice"><i class="fa-solid fa-check"></i></button>
          </div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoProducts"}}</p>{{/each}}
      </div>
      <h4 class="pim-h"><i class="fa-solid fa-handshake"></i> {{localize "PIM.Sec.contracts"}}</h4>
      <div class="pim-cards">
        {{#each h.trade.rows as |c|}}<div class="pim-card pim-contract-card">
          <div class="pim-card-txt">
            <b>{{c.buyer}}</b>
            {{#if c.desc}}<small class="pim-build-desc">{{c.desc}}</small>{{/if}}
            <small>{{c.qty}} {{c.product}} × {{c.price}} {{../cur}} / {{localize "PIM.Month"}}{{#if c.months}} · {{c.months}} {{localize "PIM.MonthsLeft"}}{{/if}}</small>
          </div>
          <div class="pim-card-num {{#if c.short}}pim-debt{{/if}}"><b>{{c.got}}/{{c.want}}</b>
            {{#if c.short}}<span class="pim-pill pim-pill-debt">{{localize "PIM.Short"}}</span>{{/if}}</div>
          <div class="pim-card-num"><b>+{{c.revenue}}</b><small>{{../cur}}</small></div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoContracts"}}</p>{{/each}}
      </div>
    {{/if}}

    {{#if (eq tab "builds")}}
      <div class="pim-cards">
        {{#each h.upgrades as |u|}}<div class="pim-card pim-build-card {{#if u.done}}done{{/if}} {{#if u.locked}}pim-locked{{/if}}" data-uid="{{u.id}}">
          {{#if u.img}}<img class="pim-card-thumb" src="{{u.img}}" alt="">{{/if}}
          <div class="pim-card-txt">
            <div class="pim-build-title">
              <b>{{u.name}}</b>
              {{#if u.done}}<span class="pim-badge-done"><i class="fa-solid fa-check"></i> {{localize "PIM.Done"}}</span>{{/if}}
            </div>
            <small class="pim-build-meta">
              {{#if u.bonus}}<span class="pim-bonus">+{{u.bonus}}/{{localize "PIM.Per"}}</span> · {{/if}}
              <span class="pim-cost">{{u.cost}} {{../cur}}</span>
              {{#if u.time}} · <span class="pim-time"><i class="fa-solid fa-hourglass-start"></i> {{u.time}} {{localize "PIM.PeriodsLeft"}}</span>{{/if}}
            </small>
            {{#if u.desc}}<small class="pim-build-desc">{{u.desc}}</small>{{/if}}
            {{#if u.locked}}<small class="pim-unit-idle"><i class="fa-solid fa-lock"></i> {{localize "PIM.Requires"}}: {{u.req}}</small>{{/if}}
            {{#if u.left}}
            <div class="pim-progress-wrap">
              <div class="pim-bar-track"><div class="pim-bar-fill" style="width:{{u.pct}}%"></div></div>
              <span class="pim-progress-txt"><i class="fa-solid fa-hammer"></i> {{u.left}} {{localize "PIM.PeriodsLeft"}}</span>
            </div>
            {{/if}}
          </div>
          <div class="pim-card-act">
            {{#if u.done}}
            {{else if u.left}}
              <span class="pim-status-building"><i class="fa-solid fa-person-digging"></i></span>
            {{else}}
              {{#if u.offered}}<button type="button" class="pim-btn-buy" data-action="buy" data-uid="{{u.id}}" data-id="{{../h.id}}" {{#unless u.afford}}disabled data-tooltip="PIM.NoFunds"{{/unless}}><i class="fa-solid fa-cart-shopping"></i> {{localize "PIM.Buy"}}</button>{{/if}}
              {{#if ../isGM}}<button type="button" class="pim-btn-subtle" data-action="offer" data-uid="{{u.id}}" data-id="{{../h.id}}">{{#if u.offered}}<i class="fa-solid fa-eye-slash"></i> {{localize "PIM.Withdraw"}}{{else}}<i class="fa-solid fa-bullhorn"></i> {{localize "PIM.Offer"}}{{/if}}</button>{{/if}}
            {{/if}}
          </div>
        </div>{{else}}<p class="pim-empty">{{localize "PIM.NoBuilds"}}</p>{{/each}}
      </div>
    {{/if}}

    {{#if (eq tab "log")}}
      <ul class="pim-log">
        {{#each h.log}}
        <li>
          <time><i class="fa-regular fa-clock"></i> {{at}}</time>
          <span>{{text}}</span>
        </li>
        {{else}}
        <p class="pim-empty">{{localize "PIM.NoLog"}}</p>
        {{/each}}
      </ul>
    {{/if}}
  </div>
</div>
